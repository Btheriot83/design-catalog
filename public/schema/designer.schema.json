{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-catalog-three.vercel.app/schema/designer.schema.json",
  "title": "DesignCatalogDesigner",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "status", "role", "bio", "links", "techniqueSlugs"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "stub", "curator", "directory"]
    },
    "role": { "type": "string" },
    "bio": { "type": "string" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "techniqueSlugs": { "type": "array", "items": { "type": "string" } },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary"],
        "properties": {
          "id": { "type": "string", "enum": ["Discover", "Define", "Deliver"] },
          "title": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "highlights": { "type": "array", "items": { "type": "string" } },
    "personalSite": { "type": ["string", "null"] }
  }
}
